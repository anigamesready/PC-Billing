# Copy to .env and fill with locally generated values. Never commit .env.
DATABASE_URL=postgresql://ani_api_login:CHANGE_ME@127.0.0.1:5432/ani_games_ready?sslmode=disable
ANI_BIND=127.0.0.1
PORT=8787
# Generate at least 32 random bytes; used only for rate-limit bucket hashing.
ANI_API_PEPPER=REPLACE_WITH_RANDOM_64_HEX
# One-time bootstrap secret generated by installer; remove after first owner bootstrap.
ANI_ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_64_HEX
# Required before binding to LAN; comma-separated exact WebView/app origins.
ANI_ALLOWED_ORIGINS=
